{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": ["src/types/**/*", "src/main/**/*", "src/preload/**/*", "src/shared/**/*", "src/core/**/*", "src/cli/**/*"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
