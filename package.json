{
  "name": "overapi",
  "version": "0.1.0",
  "private": true,
  "description": "Turn the API you can't rewrite into tools your agents can safely use. Import a spec, a traffic capture or a Postman collection, curate it, and serve it as an MCP server.",
  "license": "Apache-2.0",
  "author": "Lionel Farr <lionel@codelionsllc.com>",
  "contributors": [
    "Lionel Farr <lionel@codelionsllc.com>",
    "Owen Farr <owen@codelionsllc.com>"
  ],
  "homepage": "https://github.com/overcodelions/overapi",
  "repository": {
    "type": "git",
    "url": "https://github.com/overcodelions/overapi.git"
  },
  "main": "dist/main/index.js",
  "bin": {
    "overapi": "dist/cli/index.js"
  },
  "productName": "Overapi",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite",
    "dev:tsc": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build": "npm run build:main && npm run build:renderer && npm run check:dist",
    "build:main": "node scripts/clean-dist.mjs && tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "check:dist": "node scripts/check-dist.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit",
    "start": "electron .",
    "cli": "node dist/cli/index.js",
    "example:server": "node examples/acme-orders-server.mjs",
    "example:soap": "node examples/acme-inventory-soap-server.mjs",
    "example:webapp": "node examples/acme-support-app.mjs",
    "dist:mac": "npm run build && electron-builder --mac",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "security:aws-account-ids": "node scripts/check-no-aws-account-ids.mjs",
    "security:identities": "node scripts/check-no-forbidden-identities.mjs --all",
    "icons": "sh scripts/make-icons.sh"
  },
  "build": {
    "appId": "com.overapi.app",
    "productName": "Overapi",
    "publish": [
      {
        "provider": "github",
        "owner": "overcodelions",
        "repo": "overapi"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/shared/**/*",
      "dist/core/**/*",
      "dist/cli/**/*",
      "dist/renderer/**/*",
      "package.json",
      "!**/*.map",
      "build/trayTemplate*.png",
      "build/icon.png"
    ],
    "extraMetadata": {
      "main": "dist/main/index.js"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "notarize": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    }
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "electron": "^42.11.16",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.16",
    "typescript": "^6.0.3",
    "vite": "^6.0.3",
    "vitest": "4.1.11",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "electron-updater": "^6.8.11",
    "js-yaml": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.13"
  }
}
