<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's V8 needs both of these to run under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- overapi runs programs it did not ship: the user's `claude` / `codex`
       CLI for Read its code, Make it agent-ready and Try as an agent
       (src/main/ask.ts, src/main/discovery.ts), and the user's own Chrome
       for recording (src/main/chromeRecorder.ts). Finding /opt/homebrew/bin
       the way their shell does needs the dyld environment entitlement, and
       running a binary Apple did not sign for us needs library validation
       off. Neither widens what the app itself may do. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- The APIs it calls, the specs it fetches, and the recording browser. -->
  <key>com.apple.security.network.client</key>
  <true/>

  <!-- Specs, HARs and collections the user picks; projects they save. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <key>com.apple.security.files.downloads.read-write</key>
  <true/>
</dict>
</plist>
